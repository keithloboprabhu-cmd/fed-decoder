# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud > Settings > Secrets.
# Free-tier keys only. Never enable billing.
GEMINI_API_KEY = ""
GROQ_API_KEY = ""
# Optional, free: lets Ask search every FRED series (https://fredaccount.stlouisfed.org/apikey).
FRED_API_KEY = ""
# Optional, free: BLS's keyless limit is shared and runs out; a key gives 500 requests a day
# (https://data.bls.gov/registrationEngine/). Without it, CPI and jobs come from FRED.
BLS_API_KEY = ""
